    "eslint": "^9.38.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "prettier": "^3.6.2",
    "tsdown": "^0.15.6",
    "typescript": "^5.6.3",
    "vitest": "^4.0.17"
  },
  "description": "A comprehensive React SDK for building dynamic questionnaires with conditional fields, file uploads, and form validation.",
